# Local profile example. Copy to .env (git-ignored). Never commit real secrets.
DEPLOYMENT_PROFILE=local
ENVIRONMENT_NAME=local
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5433/tariff_dev
OBJECT_STORE_BACKEND=filesystem
OBJECT_STORE_ROOT=./.data/object-store
SECRETS_BACKEND=env
IDENTITY_BACKEND=local
LOCAL_USER_ALLOWLIST=admin@example.com:administrator,reviewer@example.com:reviewer,analyst@example.com:analyst
GOLDEN_MANIFEST_PATH=tests/golden/manifest.json
LOG_FORMAT=text
# Web app
API_BASE_URL=http://127.0.0.1:8000
LOCAL_WEB_USER=admin@example.com
# Provider keys are optional; absence means fixture mode (never labelled as real extraction)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
