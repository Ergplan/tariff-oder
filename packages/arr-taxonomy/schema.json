{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARR taxonomy and commission mapping files",
  "description": "Generated by `tariff-api arr-schema` from tariff_api.arr.taxonomy; a unit test fails on drift.",
  "oneOf": [
    {
      "$defs": {
        "Coded": {
          "additionalProperties": false,
          "properties": {
            "code": {
              "title": "Code",
              "type": "string"
            },
            "label": {
              "title": "Label",
              "type": "string"
            },
            "note": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Note"
            }
          },
          "required": [
            "code",
            "label"
          ],
          "title": "Coded",
          "type": "object"
        },
        "Identity": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "pattern": "^ARR-I\\d+$",
              "title": "Id",
              "type": "string"
            },
            "name": {
              "title": "Name",
              "type": "string"
            },
            "expression": {
              "title": "Expression",
              "type": "string"
            },
            "tolerance": {
              "anyOf": [
                {
                  "additionalProperties": {
                    "type": "number"
                  },
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Tolerance"
            },
            "severity": {
              "enum": [
                "blocking",
                "advisory"
              ],
              "title": "Severity",
              "type": "string"
            },
            "cross_order": {
              "default": false,
              "title": "Cross Order",
              "type": "boolean"
            },
            "note": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Note"
            }
          },
          "required": [
            "id",
            "name",
            "expression",
            "severity"
          ],
          "title": "Identity",
          "type": "object"
        },
        "LineItem": {
          "additionalProperties": false,
          "properties": {
            "code": {
              "pattern": "^[A-Z][A-Z0-9_.]*$",
              "title": "Code",
              "type": "string"
            },
            "label": {
              "title": "Label",
              "type": "string"
            },
            "unit": {
              "anyOf": [
                {
                  "enum": [
                    "INR_crore",
                    "MU",
                    "percent",
                    "MW",
                    "INR_per_kWh",
                    "number"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Unit"
            },
            "kind": {
              "enum": [
                "group",
                "printed",
                "computed",
                "detail"
              ],
              "title": "Kind",
              "type": "string"
            },
            "branch": {
              "enum": [
                "shared",
                "distribution",
                "transmission"
              ],
              "title": "Branch",
              "type": "string"
            },
            "parent": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Parent"
            },
            "aliases": {
              "items": {
                "type": "string"
              },
              "title": "Aliases",
              "type": "array"
            },
            "note": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Note"
            },
            "by_category": {
              "default": false,
              "title": "By Category",
              "type": "boolean"
            },
            "sign": {
              "anyOf": [
                {
                  "enum": [
                    -1,
                    1
                  ],
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Sign"
            }
          },
          "required": [
            "code",
            "label",
            "unit",
            "kind",
            "branch",
            "parent"
          ],
          "title": "LineItem",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "arr-taxonomy",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "canonical_units": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Canonical Units",
          "type": "object"
        },
        "unit_conversions": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Unit Conversions",
          "type": "object"
        },
        "fiscal_year_format": {
          "title": "Fiscal Year Format",
          "type": "string"
        },
        "value_types": {
          "items": {
            "$ref": "#/$defs/Coded"
          },
          "title": "Value Types",
          "type": "array"
        },
        "reason_categories": {
          "items": {
            "$ref": "#/$defs/Coded"
          },
          "title": "Reason Categories",
          "type": "array"
        },
        "line_items": {
          "items": {
            "$ref": "#/$defs/LineItem"
          },
          "title": "Line Items",
          "type": "array"
        },
        "identities": {
          "items": {
            "$ref": "#/$defs/Identity"
          },
          "title": "Identities",
          "type": "array"
        }
      },
      "required": [
        "id",
        "version",
        "status",
        "canonical_units",
        "unit_conversions",
        "fiscal_year_format",
        "value_types",
        "reason_categories",
        "line_items",
        "identities"
      ],
      "title": "Taxonomy",
      "type": "object"
    },
    {
      "$defs": {
        "ChapterCue": {
          "additionalProperties": false,
          "properties": {
            "branch": {
              "title": "Branch",
              "type": "string"
            },
            "heading_patterns": {
              "items": {
                "type": "string"
              },
              "title": "Heading Patterns",
              "type": "array"
            },
            "note": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Note"
            }
          },
          "required": [
            "branch",
            "heading_patterns"
          ],
          "title": "ChapterCue",
          "type": "object"
        },
        "DecidedYear": {
          "additionalProperties": false,
          "properties": {
            "fy": {
              "pattern": "^FY\\d{4}-\\d{2}$",
              "title": "Fy",
              "type": "string"
            },
            "value_type": {
              "title": "Value Type",
              "type": "string"
            }
          },
          "required": [
            "fy",
            "value_type"
          ],
          "title": "DecidedYear",
          "type": "object"
        },
        "EntryList": {
          "additionalProperties": false,
          "properties": {
            "note": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Note"
            },
            "entries": {
              "items": {
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    },
                    {
                      "items": {
                        "type": "integer"
                      },
                      "type": "array"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "type": "object"
              },
              "title": "Entries",
              "type": "array"
            }
          },
          "title": "EntryList",
          "type": "object"
        },
        "Noted": {
          "additionalProperties": false,
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Value"
            },
            "note": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Note"
            }
          },
          "title": "Noted",
          "type": "object"
        },
        "OrderExpected": {
          "additionalProperties": false,
          "properties": {
            "order_type": {
              "title": "Order Type",
              "type": "string"
            },
            "decides": {
              "items": {
                "$ref": "#/$defs/DecidedYear"
              },
              "title": "Decides",
              "type": "array"
            },
            "note": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Note"
            }
          },
          "required": [
            "order_type",
            "decides"
          ],
          "title": "OrderExpected",
          "type": "object"
        },
        "PatternList": {
          "additionalProperties": false,
          "properties": {
            "note": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Note"
            },
            "patterns": {
              "items": {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              "title": "Patterns",
              "type": "array"
            }
          },
          "title": "PatternList",
          "type": "object"
        },
        "Regulation": {
          "additionalProperties": false,
          "properties": {
            "role": {
              "title": "Role",
              "type": "string"
            },
            "title": {
              "title": "Title",
              "type": "string"
            },
            "year": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Year"
            },
            "amendments": {
              "items": {
                "type": "string"
              },
              "title": "Amendments",
              "type": "array"
            },
            "control_periods": {
              "items": {
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "type": "object"
              },
              "title": "Control Periods",
              "type": "array"
            },
            "source_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Source Id"
            },
            "note": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Note"
            }
          },
          "required": [
            "role",
            "title"
          ],
          "title": "Regulation",
          "type": "object"
        },
        "UnitConvention": {
          "additionalProperties": false,
          "properties": {
            "money": {
              "default": "INR_crore",
              "title": "Money",
              "type": "string"
            },
            "energy": {
              "default": "MU",
              "title": "Energy",
              "type": "string"
            },
            "note": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Note"
            }
          },
          "title": "UnitConvention",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z]+-arr$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "taxonomy_version": {
          "title": "Taxonomy Version",
          "type": "integer"
        },
        "commission": {
          "title": "Commission",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "licensees": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Licensees",
          "type": "object"
        },
        "regulations": {
          "items": {
            "$ref": "#/$defs/Regulation"
          },
          "title": "Regulations",
          "type": "array"
        },
        "return_basis": {
          "$ref": "#/$defs/Noted"
        },
        "gap_convention": {
          "$ref": "#/$defs/Noted"
        },
        "unit_convention": {
          "$ref": "#/$defs/UnitConvention"
        },
        "orders_expected": {
          "items": {
            "$ref": "#/$defs/OrderExpected"
          },
          "title": "Orders Expected",
          "type": "array"
        },
        "chapter_map": {
          "items": {
            "$ref": "#/$defs/ChapterCue"
          },
          "title": "Chapter Map",
          "type": "array"
        },
        "year_columns": {
          "$ref": "#/$defs/PatternList"
        },
        "voice_columns": {
          "$ref": "#/$defs/PatternList"
        },
        "label_aliases": {
          "$ref": "#/$defs/EntryList"
        },
        "regulation_clauses": {
          "$ref": "#/$defs/EntryList"
        },
        "unplaced": {
          "$ref": "#/$defs/EntryList"
        },
        "known_quirks": {
          "items": {
            "type": "string"
          },
          "title": "Known Quirks",
          "type": "array"
        }
      },
      "required": [
        "id",
        "version",
        "taxonomy_version",
        "commission",
        "status",
        "licensees",
        "regulations",
        "return_basis",
        "gap_convention",
        "unit_convention",
        "chapter_map",
        "year_columns",
        "voice_columns",
        "label_aliases",
        "regulation_clauses",
        "unplaced"
      ],
      "title": "Mapping",
      "type": "object"
    }
  ]
}
