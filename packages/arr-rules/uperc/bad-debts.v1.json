   "title": "Revenue billed for the year (receipts grossed up)",
   "output": "receivables_billed",
   "unit": "INR_crore",
   "schedule": "R-SCH-10",
   "formula": "receipts * factor",
   "inputs": {
    "receipts": {
     "unit": "INR_crore",
     "source": "record:total_receipts"
    },
    "factor": {
     "unit": "number",
     "source": "assumption:billing_gross_up",
     "note": "NPCL grosses its receipts up (1.0532 from FY2023-24; 1.0473 for FY2022-23); what the factor stands for is to be stated by the petitioner"
