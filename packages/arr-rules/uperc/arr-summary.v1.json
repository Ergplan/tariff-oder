  {
   "id": "uperc.arr.carrying",
   "version": 1,
   "status": "draft",
   "title": "Carrying cost on the regulatory asset / surplus",
   "output": "arr_carrying_cost",
   "unit": "INR_crore",
   "schedule": "R-SCH-14",
   "formula": "ifneg(accumulated + gap / 2, (accumulated + gap / 2) * gap_rate, (accumulated + gap / 2) * surplus_rate * surplus_share)",
   "inputs": {
    "accumulated": {
     "unit": "INR_crore",
     "source": "record:gap_accumulated_opening"
    },
    "gap": {
     "unit": "INR_crore",
     "source": "rule:arr_gap_after_subsidy"
    },
    "gap_rate": {
     "unit": "fraction",
     "source": "assumption:gap_carrying_rate",
     "note": "on a gap: the working-capital rate of the year (F27 row 15), as NPCL applies it"
    },
    "surplus_rate": {
     "unit": "fraction",
     "source": "assumption:surplus_carrying_rate",
     "note": "on a surplus: a deposit rate NPCL types into its formula (4.25 %, 6.75 %, 6.5 %)"
    },
    "surplus_share": {
     "unit": "percent",
     "source": "regulation",
     "value": "75",
     "note": "75 % of the deposit rate on a surplus, as NPCL's formula applies it; the clause to be confirmed"
    }
   },
   "clause": {
    "regulation": "UPERC MYT Regulations — the ARR, the revenue gap and its carrying cost",
    "clause": null,
    "source_id": null,
    "page": null,
    "excerpt": null,
    "verified": false
   },
