   "id": "uperc.revenue.energy_from_rate",
   "version": 1,
   "status": "draft",
   "title": "Energy charges of a slab from its units sold and the tariff order's energy rate",
   "output": "revenue_energy_from_rate",
   "unit": "INR_crore",
   "schedule": "R-SCH-12",
   "formula": "units * rate * (1 + adjustment)",
   "inputs": {
    "units": {
     "unit": "MU",
     "source": "record:units_sold"
    },
    "rate": {
     "unit": "INR_per_kWh",
     "source": "order:energy_rate"
    },
    "adjustment": {
     "unit": "fraction",
     "source": "order:energy_adjustment",
     "note": "the order's time-of-day percentage or rebate on the rate (negative for a reduction); 0 where none applies"
    }
   },
   "clause": {
    "regulation": "UPERC tariff order, Annexure-I Rate Schedule — energy charge per kWh by category and slab, time-of-day percentages and rebates on the rate",
