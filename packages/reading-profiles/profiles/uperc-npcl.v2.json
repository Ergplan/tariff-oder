  "locators": [
    {
      "role": "approved_schedule",
      "scope": "span",
      "pattern": "ANNEXURE\\s*[-–—]?\\s*I\\s*:?\\s*RATE SCHEDULE",
      "note": "D.1: section 12.1 ANNEXURE-I: RATE SCHEDULE FOR FY 2026-27 opens the approved schedule"
    },
    {
      "role": "approved_schedule",
      "scope": "span",
      "pattern": "RETAIL TARIFFS? FOR (THE )?FINANCIAL YEAR",
      "note": "D.1: B. RETAIL TARIFFS FOR FINANCIAL YEAR marks the start of the category schedules"
    },
    {
      "role": "derived_not_tariff",
      "scope": "page",
      "pattern": "ANNEXURE\\s*[-–—]?\\s*II\\b",
      "also_on_page": [
        "average billing rate|ABR|fuel.{0,30}surcharge"
      ],
      "note": "D.2 hazard 3: Annexure-II Rs/kWh averages exist only for fuel-surcharge computation"
    },
    {
      "role": "proposed_tariff",
      "scope": "page",
      "pattern": "petitioner.{0,80}proposed|tariff proposal|proposed (by the petitioner|tariff)",
      "note": "D.2 hazard 2: Chapter 7 proposals (20% TOD, 85% billable demand) were not approved"
    },
    {
      "role": "existing_tariff",
      "scope": "page",
      "pattern": "existing tariff",
      "note": "existing-tariff columns and tables in the tariff chapter"
    },
    {
      "role": "illustrative",
      "scope": "page",
      "pattern": "bill impact|illustrative",
      "note": "bill-impact tables are not tariffs"
    },
    {
      "role": "loss_trajectory",
      "scope": "page",
      "pattern": "distribution loss(es)?.{0,60}(trajectory|approved)|approved.{0,40}distribution loss",
      "note": "D.4: Table 6-7 approved loss trajectory; a different role from open-access losses"
    },
    {
      "role": "network_charges",
      "sub_role": "wheeling_charge",
      "scope": "page",
      "pattern": "wheeling charge",
      "note": "D.4: Chapter 9.2, Table 9-5"
    },
    {
      "role": "network_charges",
      "sub_role": "oa_loss",
      "scope": "page",
      "pattern": "open access.{0,60}loss|loss(es)?.{0,60}open access",
      "note": "D.4: Table 9-11 losses for open-access billing"
    },
    {
      "role": "network_charges",
      "sub_role": "cross_subsidy_surcharge",
      "scope": "page",
      "pattern": "cross[- ]subsidy surcharge",
      "note": "D.4: Tables 9-12 to 9-14; only the approved column is leviable"
    },
    {
      "role": "network_charges",
      "sub_role": "additional_surcharge",
      "scope": "page",
      "pattern": "additional surcharge",
      "note": "D.4: 9.4.7 approves the additional surcharge as zero"
    },
    {
      "role": "network_charges",
      "sub_role": "banking_rule",
      "scope": "page",
      "pattern": "\\b(?:banking\\s+of\\s+(?:power|energy)|banked\\s+(?:power|energy|units)|banking\\s+(?:facility|arrangement|provision|charges?\\s+for\\s+(?:banked|renewable|green|open\\s+access))|open\\s+access[^.\\n]{0,80}\\bbanking\\b|\\bbanking\\b[^.\\n]{0,80}open\\s+access)",
      "note": "D.4: 6.5.19-6.5.33 discuss banking; verify whether any consumer-facing rule is determined v2 (2026-09-14, NPCL review): the v1 cue `\\bbanking\\b` matched 'internet banking' and 'Banking and Finance Charges' (a financing cost); the cue now needs banking of power/energy, banked units, or banking next to open access."
    },
    {
      "role": "green_tariff",
      "scope": "page",
      "pattern": "green (energy )?tariff",
      "note": "D.4: general provision 20"
    }
  ],
