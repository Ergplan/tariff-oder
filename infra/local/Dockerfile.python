# Python service image: API and worker share one image; the command selects the role.
# amd64 by default (Cloud Run); build with --platform for Apple-silicon developers (Section 3.2).
FROM python:3.11-slim-bookworm AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.9.7 /uv /uvx /bin/
WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY services/api/pyproject.toml services/api/pyproject.toml
COPY services/worker/pyproject.toml services/worker/pyproject.toml
RUN mkdir -p services/api/src/tariff_api services/worker/src/tariff_worker \
    && touch services/api/src/tariff_api/__init__.py services/worker/src/tariff_worker/__init__.py \
    && uv sync --all-packages --no-dev --frozen
COPY services ./services
COPY tests/golden ./tests/golden
RUN uv sync --all-packages --no-dev --frozen
ENV PATH="/app/.venv/bin:$PATH"
RUN useradd -r -u 10001 app && mkdir -p /data/object-store && chown -R app:app /data
USER app
EXPOSE 8000
CMD ["uvicorn", "tariff_api.asgi:app", "--host", "0.0.0.0", "--port", "8000"]
